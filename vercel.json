{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron-funnel",
      "schedule": "0 7 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/roma",
      "destination": "/market/roma/",
      "permanent": true
    },
    {
      "source": "/milano",
      "destination": "/market/milano/",
      "permanent": true
    },
    {
      "source": "/napoli",
      "destination": "/market/napoli/",
      "permanent": true
    },
    {
      "source": "/firenze",
      "destination": "/market/firenze/",
      "permanent": true
    },
    {
      "source": "/market/roma",
      "destination": "/market/roma/",
      "permanent": true
    },
    {
      "source": "/market/milano",
      "destination": "/market/milano/",
      "permanent": true
    },
    {
      "source": "/market/napoli",
      "destination": "/market/napoli/",
      "permanent": true
    },
    {
      "source": "/market/firenze",
      "destination": "/market/firenze/",
      "permanent": true
    },
    {
      "source": "/immobili/roma",
      "destination": "/immobili/roma/",
      "permanent": true
    },
    {
      "source": "/immobili/milano",
      "destination": "/immobili/milano/",
      "permanent": true
    },
    {
      "source": "/immobili/napoli",
      "destination": "/immobili/napoli/",
      "permanent": true
    },
    {
      "source": "/immobili/firenze",
      "destination": "/immobili/firenze/",
      "permanent": true
    },
    {
      "source": "/mutuo",
      "destination": "/mutui/",
      "permanent": true
    },
    {
      "source": "/roi",
      "destination": "/roi-bnb/",
      "permanent": true
    },
    {
      "source": "/roi/",
      "destination": "/roi-bnb/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self)"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/login/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/dashboard/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/dashboard-leads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/dashboard-report/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/guest-report/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/pro-success/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/cron-funnel.js": {
      "maxDuration": 60
    }
  }
}
